ОТЛОЖЕННЫЕ ТЕСТЫ — НЕ СОБИРАЮТСЯ (расширение `.kt.pending` Kotlin не подхватывает).

Что проверяют (три дефекта, найденные ревью Н2 руками):
  1. тап по имени короткого тега не удаляет тег — крестик 12dp, штатный near-hit Compose
     расширяет его зону до 48dp по обеим осям и накрывает имя чипа `#дом`;
  2. чекбокс списка задач: роль `Checkbox` и описание, которое НЕ приписывает состояние
     неотмеченному флажку (прежнее «сделана: $title» TalkBack читал как утверждение);
     этот тест — про `TasksScreen`, а не про деталку, и его место в `TasksScreenTest.kt`
     (сигнатура `TasksScreen` в Н2 вырастает на восемь параметров, отсюда своя фикстура);
  3. сегмент статуса в деталке: роль `RadioButton` и корректное «выбрано».

Почему лежит файлом, а не тестом: `TaskDetailScreen`, `RemovableTag` и вся семантика
чекбокса живут только в ветке `slice-h2` (срез Н2) и в `main` на 2026-08-30 отсутствуют —
код не компилируется. Срез nikitatrubaev-0rk.16 поставил рельсы (Robolectric + compose
ui-test в `testDebugUnitTest`); эти тесты — их продолжение, см. `bd nikitatrubaev-0rk.20`.

Что нужно, чтобы наложить:
  - слитый в `main` срез Н2 (`slice-h2`, вершина на момент написания — 2d09280);
  - переименовать в `app/src/test/kotlin/com/roflochinsky/noteapp/ui/TaskDetailSemanticsTest.kt`
    (папку `pending/` убрать целиком) и прогнать `bin/gate`.

Проверять при наложении: тесты писаны против ПОВЕДЕНИЯ, а не против глушилки `pointerInput`
в `RemovableTag` — реализация фикса могла смениться, тесты меняться не должны. Отдельно
сверить п.1: ширина текста у Robolectric не устройская (шрифта нет), и если `#дом` окажется
шире зоны near-hit, тап по центру имени перестанет её задевать и тест выродится в зелёный
навсегда. Тогда взять тег покороче или кликать по левому краю имени
(`performTouchInput { click(centerLeft) }`) и обязательно доказать мутацией — снять глушилку
в `RemovableTag` и увидеть падение ИМЕННО этого теста.

--------------------------------------------------------------------------------

package com.roflochinsky.noteapp.ui

import androidx.compose.ui.semantics.Role
import androidx.compose.ui.semantics.SemanticsProperties
import androidx.compose.ui.test.SemanticsMatcher
import androidx.compose.ui.test.assert
import androidx.compose.ui.test.assertContentDescriptionEquals
import androidx.compose.ui.test.assertIsNotSelected
import androidx.compose.ui.test.assertIsSelected
import androidx.compose.ui.test.isSelectable
import androidx.compose.ui.test.isToggleable
import androidx.compose.ui.test.junit4.createComposeRule
import androidx.compose.ui.test.onNodeWithContentDescription
import androidx.compose.ui.test.onNodeWithText
import androidx.compose.ui.test.performClick
import com.roflochinsky.noteapp.pipeline.Edit
import com.roflochinsky.noteapp.pipeline.TaskFile
import java.time.LocalDate
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNull
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.RobolectricTestRunner

/** Семантика и попадания в деталке задачи: то, что ревью Н2 ловило чтением кода. */
@RunWith(RobolectricTestRunner::class)
class TaskDetailSemanticsTest {

    @get:Rule val compose = createComposeRule()

    private val today = LocalDate.of(2026, 8, 26)
    private var lastEdit: Edit? = null
    private var lastStatus: String? = null

    private fun task(status: String = TaskFile.STATUS_OPEN) =
        TaskFile.Task(
            path = "tasks/hleb.md",
            title = "Купить хлеб",
            status = status,
            created = LocalDate.of(2026, 8, 1),
            tags = listOf("дом"),
        )

    private fun detail(task: TaskFile.Task) {
        compose.setContent {
            DocTheme {
                TaskDetailScreen(
                    task = task,
                    projects = emptyList(),
                    pending = false,
                    today = today,
                    notice = null,
                    onNotice = {},
                    onEdit = { lastEdit = it },
                    onStatus = { lastStatus = it },
                    onDelete = {},
                    onOpen = {},
                    onBack = {},
                )
            }
        }
    }

    /**
     * Имя тега — не кнопка удаления. Короткий тег целиком помещается в near-hit крестика, и до
     * фикса Н2 тап по слову сносил тег молча.
     */
    @Test
    fun `тап по имени тега не удаляет тег`() {
        detail(task())
        compose.onNodeWithText("#дом").performClick()
        assertNull(lastEdit)
    }

    /** Контроль к предыдущему: крестик обязан удалять, иначе «ничего не происходит» пройдёт всегда. */
    @Test
    fun `тап по крестику удаляет тег`() {
        detail(task())
        compose.onNodeWithContentDescription("убрать тег #дом").performClick()
        assertEquals(Edit.SetField("tags", null), lastEdit)
    }

    /** Сегмент статуса — переключатель, а не три подписи: на слух `in_progress` иначе неотличим. */
    @Test
    fun `сегмент статуса — радиокнопка и знает, что выбрано`() {
        detail(task(status = TaskFile.STATUS_IN_PROGRESS))
        compose
            .onNodeWithText("в работе")
            .assert(isSelectable())
            .assert(SemanticsMatcher.expectValue(SemanticsProperties.Role, Role.RadioButton))
            .assertIsSelected()
        compose.onNodeWithText("открыта").assertIsNotSelected()
    }
}

// --- в TasksScreenTest.kt, рядом с уже лежащими там тестами списка ---

    /**
     * TalkBack должен читать «флажок, не отмечено, Купить хлеб». Состояние добавляет сама роль; в
     * описании его быть не должно — иначе неотмеченный флажок утверждает, что задача сделана.
     *
     * `screen(...)` придётся дополнить параметрами Н2 (`notice`, `pending`, `onTask`, `onNewTask`,
     * `onToggle`, `onCancel`, `onFlush`, `onNotice`) — заглушками, кроме `onToggle`.
     */
    @Test
    fun `чекбокс задачи — флажок с описанием без состояния`() {
        screen(listOf(task("Купить хлеб")))
        compose
            .onNode(isToggleable())
            .assert(SemanticsMatcher.expectValue(SemanticsProperties.Role, Role.Checkbox))
            .assertContentDescriptionEquals("Купить хлеб")
    }
